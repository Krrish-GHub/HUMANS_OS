[Desktop Entry]
Type=Application
Name=H.U.M.A.N.S Agent
Comment=Ask Gemini with optional personal context and confirmed local actions
Exec=xfce4-terminal --execute humans-agent chat
Icon=utilities-terminal
Terminal=false
Categories=Utility;System;
Actions=Configure;Recommend;

[Desktop Action Configure]
Name=Configure Gemini API key
Exec=xfce4-terminal --execute humans-agent configure
OnlyShowIn=XFCE;

[Desktop Action Recommend]
Name=Get video recommendations
Exec=humans-agent recommend-ui
OnlyShowIn=XFCE;
